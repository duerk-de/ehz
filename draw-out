#!/bin/bash

function imgcfg_out()
{
	local img="$1"
	local log="$2"
	
	cat <<EOF

imgx = 1600
# imgx = 1180
imgy = 1120
border = 3

# monday, before new year
year2025start = 1735516800
yearstart = year2025start - timezoneof now * hours

y0  = -200
y1  = 2800
# x1 = $(date +%s -d "2026-09-26 8:15")
x1 = now

lumscale = 1

xmin  = -yearstart + x1 - 0.5 * hours
xmax  = -yearstart + x1
ymin  = y0
ymax  = y1

gridxtype = date
gridx = 15 secs
gridy = 50
gridl = 0.5
griddl = 1.5
grid

bailout = true
bailin = true
backward = true

time            =  1
power           =  2
ncol = power
powerbatt       =  3
stat_foff       =  4
stat_cons       =  5
stat_setp_err   =  6
stat_var        =  7
level           =  8
volt            =  9
volt_diff       = 10
volt_max        = 11
volt_min        = 12
hivolt          = 13
full            = 14
powerdiff       = 15
volt_num_const  = 16

total     = 0
solar     = 1
external  = 2
generator = 3
battery   = 4

data : $log
avg  = 1
step = 1
type = points

pxy = 1.2
plotx : pxy * xpxls
ploty : pxy * ypxls

# red: current power consumption
lum   : 0.2 * lumscale
sat   : 3
hue   : 0
datax : col[time+total*ncol] - yearstart
datay : [ col[power+total*ncol] maximum y0 ] minimum y1
plot

# pinkish: power from extern, needs to be payed
lum   : 0.2 * lumscale
sat   : 3
hue   : 340
datax : col[time+external*ncol] - yearstart
datay : [ col[power+external*ncol] maximum y0 ] minimum y1
plot

# yellow: power from sun
lum   : 0.1 * lumscale
sat   : 3
hue   : 50
datax : col[time+solar*ncol] - yearstart
datay : [ col[power+solar*ncol] maximum y0 ] minimum y1
plot

# green: power from local generator unit
lum   : 0.10 * lumscale
sat   : 3
hue   : 120
datax : col[time+generator*ncol] - yearstart
datay : [ col[power+generator*ncol] maximum y0 ] minimum y1
plot

# # blue: consumption of battery
# lum   : 0.10 * lumscale
# sat   : 3
# hue   : 200
# datax : [ col[time+solar*ncol] + col[time+generator*ncol] ] / 2 - yearstart
# datay : col[power+solar*ncol] - col[power+generator*ncol] + col[power+battery*ncol]
# plot

# green: power of battery
lum   : 0.05 * lumscale
sat   : 3
hue   : 180
datax : col[time+battery*ncol] - yearstart
datay : [ - col[power+battery*ncol] maximum y0 ] minimum y1
plot

# # green: powerbatt of battery
# lum   : 0.05 * lumscale
# sat   : 3
# hue   : 160
# datax : col[time+battery*ncol] - yearstart
# datay : [ - col[powerbatt+battery*ncol] maximum y0 ] minimum y1
# plot

# #
# lum   : 0.05 * lumscale
# sat   : 3
# hue   : 210
# datax : col[time+battery*ncol] - yearstart
# datay : col[stat_cons+battery*ncol]
# plot

# required offset of setpoint
lum   : 0.15 * lumscale
sat   : 0.05
hue   : 260
datax : col[time+battery*ncol] - yearstart
datay : [ col[stat_foff+battery*ncol] maximum y0 ] minimum y1
plot

data : $log
data : $log.1
avg  = 10
step = 1
type = points

# # green: powerdiff of battery
# lum   : 0.05 * lumscale
# sat   : 3
# hue   : 140
# datax : col[time+battery*ncol] - yearstart
# datay : - col[powerdiff+battery*ncol] * 10
# plot

voltmax = 3.65
voltmin = 3.000
voltscale = 0.0125 / gridy

datax : col[time+battery*ncol] - yearstart

lum   : 0.07 * lumscale
sat   : 3
hue   : 20
datay : [ col[volt+battery*ncol] - voltmax ] / voltscale + y1
plot
datay : [ col[volt_max+battery*ncol] - voltmax ] / voltscale + y1
plot
datay : [ col[volt_min+battery*ncol] - voltmax ] / voltscale + y1
plot

lum   : 0.04 * lumscale
sat   : 0
hue   : 20
datay : [ 3.5 - voltmax ] / voltscale + y1
plot
datay : [ 3.3 - voltmax ] / voltscale + y1
plot
datay : [ 3.2 - voltmax ] / voltscale + y1
plot

# lum   : 0.25 * lumscale
# sat   : 0.01
# hue   : 180
# datax : col[time+battery*ncol] - yearstart
# datay : col[volt_num_const+battery*ncol] * 50 + 1500
# plot

vnc_ypos = y1 - 25
vnc_size = 15
vnc_lum = 0.12
sat   : 3
datax : col[time+battery*ncol] - yearstart
datay : vnc_ypos
lum   : vnc_lum * 3 / 4 * lumscale
hue   : 260
ploty : col[volt_num_const+battery*ncol] * 2 * vnc_size
plot
lum   : vnc_lum / 3 * lumscale
hue   : 120
ploty : col[volt_num_const+battery*ncol] * vnc_size
plot



# lum   : 0.07 * lumscale
# sat   : 3
# hue   : 20
# datax : col[time+battery*ncol] - yearstart
# datay : col[stat_var+battery*ncol]
# plot

pxy = 5
plotx : pxy * xpxls
ploty : pxy * ypxls

lum   : 0.01 * lumscale
sat   : 3
hue   : 180
datax : col[time+battery*ncol] - yearstart
datay : col[level+battery*ncol] * [ y1 - y0 ] + y0
plot


out   : $img

EOF

}

function drawout()
{
	local log="$1"
	local img="$2"
	
	# imgcfg_out "$img" "$log" | xargs -d \\n printf " '%s'" draw
	imgcfg_out "$img" "$log" | xargs -d \\n draw
}

drawout "$@"
