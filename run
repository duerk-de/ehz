#!/bin/bash

source "/dibom/src/bash/inc.sh"

function run()
{
	local dir="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
	local name="$(basename "$dir")"
	local config="$dir/$name.cfg"
	eval "$(read_config "$config")"
	local errlog="$(dirname "${out[log1file]}")/$name.err.log"
	local logfd
	exec {logfd}>>"$errlog"
	echo "using error log file $errlog"
	echo "---"
	"$dir/$name" 2> >(print_job "red" "date" "$logfd")
	local ret=$?
	echo "---"
	sleepms 500
	exec {logfd}>&-
	return $ret
}

function main()
{
	while ! run ; do
		echo
		./err.sh "failed assertion"
		>&2 printf_col red bold "%s - an error occured\n" "$(date_stamp)"
		sleep 60
	done
	echo "done"
}


main "$@"

